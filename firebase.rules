rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Helper function: Check if document is owned by the user
    function isDocumentOwner() {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Prevent accidental deletion
    }

    // Links collection
    match /links/{linkId} {
      // Read: Allow if link is active (public) or user owns it
      allow read: if resource.data.isActive == true || isDocumentOwner();
      
      // Create: Must be authenticated and have a valid userId
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.shortCode != null &&
        request.resource.data.longUrl != null;
      
      // Update: Must be owner
      allow update: if isAuthenticated() && isDocumentOwner();
      
      // Delete: Must be owner
      allow delete: if isAuthenticated() && isDocumentOwner();
    }

    // Analytics collection (optional - for future use)
    match /analytics/{analyticId} {
      allow read: if isAuthenticated() && isDocumentOwner();
      allow write: if isAuthenticated() && isDocumentOwner();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isDocumentOwner();
      allow delete: if false;
    }
  }
}