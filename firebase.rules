rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isDocumentOwner() {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    function isGuestLink() {
      return resource.data.isGuest == true && resource.data.userId == null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // Links collection - Critical for redirect reliability
    match /links/{linkId} {
      // Read: Allow if link is active (public) or user owns it
      // This is the most important rule for redirects
      allow read: if 
        resource.data.isActive == true || 
        isDocumentOwner() ||
        isGuestLink();
      
      // Create: Anyone can create (guest or authenticated)
      allow create: if 
        (request.resource.data.shortCode != null &&
        request.resource.data.longUrl != null) &&
        (
          (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
          (request.resource.data.isGuest == true && request.resource.data.userId == null)
        );
      
      // Update: Must be owner
      allow update: if isAuthenticated() && isDocumentOwner();
      
      // Delete: Must be owner
      allow delete: if isAuthenticated() && isDocumentOwner();
      
      // List: Only for authenticated users with their own links
      allow list: if isAuthenticated() && request.query.userId == request.auth.uid;
    }

    // Analytics collection
    match /analytics/{analyticId} {
      allow read: if isAuthenticated() && isDocumentOwner();
      allow write: if isAuthenticated() && isDocumentOwner();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isDocumentOwner();
      allow delete: if false;
    }
  }
}